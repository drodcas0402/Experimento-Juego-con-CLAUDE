 if(!sel.move)return `<b>Turno ${turn}: ¿qué hace ${u.n}?</b><div class="mv">${u.mv.map((m,i)=>`<button onclick="pickMove(${i})"${(u.cd[m.n]>0||(u.taunt&&m.cat!=='físico'&&m.cat!=='especial')||(m.req==='sangre'&&![...A,...F].some(x=>x.hp>0&&x.sangrado)))?' disabled':''}><b>${m.n}</b><br><small>${m.cat}${m.p?' · pot. '+m.p+' · prec. '+m.a+(m.prio?' · prioridad':'')+(m.sac?' · cuesta '+Math.round(m.sac*100)+'% de vida':'')+(m.golpes?' · '+(m.cadena&&m.cadena.every(c=>c===1)?'':'hasta ')+m.golpes+' golpes':'')+(m.sangra?' · '+Math.round(m.sangra*100)+'% de sangrado':'')+(m.para?' · '+m.para*100+'% de paralizar':''):m.cat==='ciego'?' · los rivales fallan más (precisión a la mitad), '+m.turnos+' turnos':m.cat==='provocar'?' · los rivales solo pueden atacar, '+m.turnos+' turnos':m.cat==='pantalla'?' · el equipo recibe '+Math.round(m.red*100)+'% menos de daño, '+m.turnos+' turnos':m.cat==='virus'?' · quita '+m.dano*100+'% de vida por turno, '+m.turnos+' turnos':m.cat==='regen'?' · cura '+m.cura*100+'% por turno, '+m.turnos+' turnos':m.cat==='escudo'?' · rechaza ataques, quita estados, cura '+m.cura*100+'%':m.cura?' · cura '+m.cura*100+'%'+(m.req?' · solo si alguien sangra':'')+(m.limpia?' y quita estados negativos':'')+(m.regen?' y regenera '+m.regen.p*100+'% por turno, '+m.regen.t+' turnos':''):' · '+statTxt(m)}${u.cd[m.n]>0?' · disponible en '+u.cd[m.n]+' turno':m.cd?' · recarga '+m.cd+' turno':''}</small></button>`).join('')}${alive(B).some(b=>!sel.acts.some(a=>a.t===b))?`<button onclick="pickSwitch()"><b>⇄ Cambiar</b><br><small>gasta el turno</small></button>`:''}${back_}</div>`;
 const side=sel.move.t==='enemigo'?'F':sel.move.t==='banca'?'B':'A',list=({F,A,B})[side];
 return `<b>${u.n} usa ${sel.move.n}: elige objetivo</b><div class="mv">${list.map((t,i)=>t.hp>0&&!(side==='B'&&sel.acts.some(a=>a.t===t))?`<button onclick="pickTarget('${side}',${i})"><b>${t.n}</b><br><small>Vida ${t.hp}/${t.vida}</small></button>`:'').join('')}${back_}</div>`;
}
let screen='menu',picked=[]; // pantalla actual y equipo elegido (los 2 primeros salen al campo)
function toMenu(){screen='menu';draw()}
function toTeam(){screen='team';draw()}
function toggle(i){const p=picked.indexOf(i);if(p>=0)picked.splice(p,1);else if(picked.length<4)picked.push(i);draw()}
function drawScreen(){
 const app=$('#app');
 if(screen==='menu'){app.innerHTML=`<div class="ctl" style="text-align:center;padding:32px 12px"><h2 style="margin:0 0 6px">Anime Showdown</h2><small>Combate por turnos 2 contra 2</small><div class="mv" style="grid-template-columns:1fr;max-width:240px;margin:20px auto 0"><button onclick="toTeam()" style="text-align:center"><b>▶ Jugar</b></button></div></div>`;return}
 app.innerHTML=`<div class="ctl"><b>Elige tu equipo</b>${picked.length?'':'<div style="margin:6px 0"><b class="dn">Selecciona los personajes</b></div>'}<small>Toca para añadir o quitar (2 a 4 personajes). Los 2 primeros que elijas salen al campo; el resto empieza en la banca.</small></div>${SERIES.map(s=>`<div style="margin:14px 0 6px"><b>${s.n}</b></div><div class="team">${s.ch.map(u=>{const i=ROSTER.indexOf(u),p=picked.indexOf(i);return `<button class="pan ${p>=0?'cur':''}" onclick="toggle(${i})"><div class="row"><div class="av" style="background:${u.c}">${u.n[0]}</div><div style="flex:1"><b>${u.n}</b> ${p>=0?`<small class="up">${p<2?'Campo '+(p+1):'Banca'}</small>`:''}<br><small>Vida ${u.vida} · Atq ${u.ataque} · Def ${u.defensa} · AtE ${u.atkEsp} · DefE ${u.defEsp} · Vel ${u.velocidad}</small></div></div><div style="margin-top:6px"><small>${u.mv.map(m=>m.n).join(' · ')}</small></div><div style="margin-top:4px"><small>✨ <b>${u.ab.n}</b>: ${u.ab.d}</small></div></button>`}).join('')}</div>`).join('')}<div class="mv" style="margin-top:12px"><button onclick="toMenu()">← Atrás</button><button onclick="reset()"${picked.length<2?' disabled':''}><b>⚔ Combatir</b><br><small>${picked.length} personajes · rivales: 2 maniquíes</small></button></div>`;
}
function draw(){
 if(screen!=='battle'){lg.style.display='none';return drawScreen()}
 lg.style.display='';
 const cur=over?null:actor();
 $('#app').innerHTML=`<small>Rivales</small><div class="team">${F.map(u=>pan(u)).join('')}</div><small>Tu equipo</small><div class="team">${A.map(u=>pan(u,u===cur)).join('')}</div>${B.length?`<small>Banca</small><div class="team">${B.map(u=>pan(u)).join('')}</div>`:''}<div class="ctl">${ctl()}</div>`;
}
// Regla: todo personaje jugable tiene siempre 4 movimientos
ROSTER.forEach(c=>{if(c.mv.length!==4)console.warn(c.n+' debe tener 4 movimientos, tiene '+c.mv.length)});
draw();
</script></body></html>
