<html lang="es"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Anime Showdown</title>
<style>
:root{--bg:#f6f5f2;--card:#fff;--tx:#1d1d1f;--mu:#6b6b70;--bd:#d9d7d2;--ac:#c2410c;--up:#15803d;--dn:#b91c1c;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17171a;--card:#232328;--tx:#f0efec;--mu:#9a9aa2;--bd:#3a3a42;--ac:#fb923c;--up:#4ade80;--dn:#f87171}}
:root[data-theme="dark"]{--bg:#17171a;--card:#232328;--tx:#f0efec;--mu:#9a9aa2;--bd:#3a3a42;--ac:#fb923c;--up:#4ade80;--dn:#f87171}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:16px system-ui,sans-serif}
main{max-width:720px;margin:0 auto;padding:16px}
h1{font-size:20px;margin:0 0 12px}
button{font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:10px 14px;cursor:pointer;text-align:left}
button:hover:not(:disabled){border-color:var(--ac)}button:disabled{opacity:.4;cursor:default}
.team{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.pan{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px}
.pan.ko{opacity:.45}.pan.cur{border-color:var(--ac);outline:2px solid var(--ac)}
.row{display:flex;align-items:center;gap:8px}
.av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;flex:none}
.bar{height:10px;background:var(--bd);border-radius:5px;overflow:hidden;margin-top:4px}
.bar i{display:block;height:100%;background:#16a34a;transition:width .3s}
.st{display:grid;grid-template-columns:1fr 1fr;gap:2px 8px;margin-top:8px;font-size:13px}
.up{color:var(--up);font-weight:600}.dn{color:var(--dn);font-weight:600}
small{color:var(--mu)}
.ctl{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px}
.mv{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:8px}
#log{height:200px;overflow:auto;font-size:14px;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:10px;margin-top:10px}
@media (max-width:520px){.team{grid-template-columns:1fr}}
</style></head><body><main>
